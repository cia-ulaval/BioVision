# Copier ce fichier en .env et remplacer les chemins par ceux de votre machine.
# Utiliser des / même sous Windows.

# Dossier contenant IDs/ et annotations/ (monté en lecture seule)
VIDEOS_DIR=D:/chemin/vers/Videos/Caribou

# Dossier où écrire les frames extraites, en dehors du dossier des vidéos
FRAMES_DIR=D:/chemin/vers/frames